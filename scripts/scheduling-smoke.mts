const require=createRequire(import.meta.url);const Database=require("better-sqlite3");const db=new Database(join(folder,"test.db"));
const migrations=new URL("../prisma/migrations/",import.meta.url);
for(const m of readdirSync(migrations).sort())if(m!=="migration_lock.toml")db.exec(readFileSync(new URL(m+"/migration.sql",migrations),"utf8"));
