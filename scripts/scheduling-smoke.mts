const folder=mkdtempSync(join(tmpdir(),"signal-scheduling-http-"));
Object.assign(process.env,{DATABASE_PROVIDER:"sqlite",DATABASE_URL:"file:"+join(folder,"test.db"),AUTH_SECRET:randomBytes(32).toString("hex"),EMAIL_PROVIDER:"disabled",SIGNAL_SCHEDULING_ENABLED:"true",SIGNAL_SCHEDULER_CONFIGURED:"true",CRON_SECRET:randomBytes(32).toString("hex"),X_CLIENT_ID:"fixture-client",X_CLIENT_SECRET:"fixture-secret"});
