# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Your app's public URL (no trailing slash, no path)
APP_URL="http://localhost:3000"

# Password recovery: disabled by default. Use resend after verifying a sender.
# See docs/password-recovery.md. Never prefix these keys with NEXT_PUBLIC_.
EMAIL_PROVIDER="disabled"
RESEND_API_KEY=""
EMAIL_FROM=""

# Local SQLite database
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER="sqlite"

# Hosted libSQL database. Set DATABASE_PROVIDER=turso only when ready to switch.
# Keep DATABASE_URL unchanged for local Prisma migrations.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Encrypts stored OAuth tokens — generate with the same command as AUTH_SECRET above
TOKEN_ENCRYPTION_KEY=""

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# X / Twitter OAuth 2.0 (developer.x.com)
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Meta / Facebook (developers.facebook.com)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# TikTok for Developers
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Gemini API (aistudio.google.com)
GEMINI_API_KEY=""
