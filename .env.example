# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Your app's public URL (no trailing slash, no path)
APP_URL="http://localhost:3000"

# Password recovery: disabled by default. Use resend after verifying a sender.
# See docs/password-recovery.md. Never prefix these keys with NEXT_PUBLIC_.
EMAIL_PROVIDER="disabled"
SUPPORT_EMAIL="paulayoade18@gmail.com"
EMAIL_REPLY_TO="paulayoade18@gmail.com"
RESEND_API_KEY=""
EMAIL_FROM=""

# Local SQLite database
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER="sqlite"

# Hosted libSQL database. Set DATABASE_PROVIDER=turso only when ready to switch.
# Keep DATABASE_URL unchanged for local Prisma migrations.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Encrypts stored OAuth tokens — generate with the same command as AUTH_SECRET above
TOKEN_ENCRYPTION_KEY=""

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# X / Twitter OAuth 2.0 (developer.x.com)
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Meta / Facebook (developers.facebook.com)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_CONFIG_ID=""

# TikTok for Developers
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Gemini API (aistudio.google.com)
GEMINI_API_KEY=""
# Optional model override. Leave blank to use Signal's tested default.
GEMINI_MODEL=""

# Launch controls: server-only. false pauses new operations; redeploy after changes.
SIGNAL_AI_ENABLED="true"
SIGNAL_METRICS_ENABLED="true"
SIGNAL_PUBLISHING_ENABLED="true"
# Exact database User IDs, comma-separated. Never emails, plans or NEXT_PUBLIC_.
SIGNAL_ADMIN_USER_IDS=""
SIGNAL_AI_FREE_DAILY="5"
SIGNAL_AI_PRO_DAILY="30"
SIGNAL_METRICS_FREE_DAILY="2"
SIGNAL_METRICS_PRO_DAILY="8"
SIGNAL_PUBLISHING_FREE_DAILY="2"
SIGNAL_PUBLISHING_PRO_DAILY="10"
SIGNAL_AI_GLOBAL_DAILY="100"
SIGNAL_AI_GLOBAL_MONTHLY="2000"
SIGNAL_METRICS_GLOBAL_DAILY="100"
SIGNAL_METRICS_GLOBAL_MONTHLY="2000"
SIGNAL_PUBLISHING_GLOBAL_DAILY="100"
SIGNAL_PUBLISHING_GLOBAL_MONTHLY="2000"
