generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  hashedPassword String?
  image          String?
  plan            String    @default("FREE")
  sessionVersion  Int       @default(0)
  aiInsightsEnabled                 Boolean   @default(true)
  personalizedRecommendationsEnabled Boolean   @default(true)
  analyticsCollectionEnabled        Boolean   @default(true)
  accounts       Account[]
  sessions       Session[]
  connectedAccounts ConnectedAccount[]
  createdAt      DateTime  @default(now())
}

model ConnectedAccount {
  id             String            @id @default(cuid())
  userId         String
  platform       String
  platformUserId String?
  displayName    String?
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricSnapshots MetricSnapshot[]
  posts          Post[]

  @@unique([userId, platform])
}

model Post {
  id                 String            @id @default(cuid())
  connectedAccountId String
  platformPostId     String
  text               String
  url                String?
  tags               String?
  permalinkUrl       String?
  likeCount          Int               @default(0)
  viewCount          Int               @default(0)
  replyCount         Int               @default(0)
  retweetCount       Int               @default(0)
  postedAt           DateTime?
  fetchedAt          DateTime          @default(now())
  connectedAccount   ConnectedAccount  @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, platformPostId])
}

model MetricSnapshot {
  id                 String           @id @default(cuid())
  connectedAccountId String
  followersCount     Int
  followingCount     Int
  postCount          Int
  totalLikes         Int              @default(0)
  totalViews         Int              @default(0)
  postsAnalyzed      Int              @default(0)
  fetchedAt          DateTime         @default(now())
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

